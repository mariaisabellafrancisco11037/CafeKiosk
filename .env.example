# LOCAL DEVELOPMENT ONLY. Do not upload a real .env containing passwords.
PORT=5000
BIND_HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafekiosk

# Railway: add this in the CafeKiosk service Variables tab.
# MYSQL_URL=${{MySQL.MYSQL_URL}}
# If your Railway database service has another name, replace MySQL above.

# Optional public URL override. Usually Railway request headers/public domain are enough.
# PUBLIC_APP_URL=https://your-cafekiosk-domain.up.railway.app
# KIOSK_BASE_URL=https://your-cafekiosk-domain.up.railway.app

AUTO_INIT_DB=true

# Demo Cafe seed (cafe-1 only). Railway startup runs this automatically.
AUTO_SEED_DEMO=true

# ============================================================
# STAFF / MANAGER EMAIL INVITATIONS
# ============================================================
# On Railway, add these in CafeKiosk -> Variables. Do NOT commit real passwords.
# Example SMTP configuration (replace with your email provider values):
# Staff / Manager invitations via Resend HTTPS API
RESEND_API_KEY=
RESEND_FROM_EMAIL=invites@your-verified-domain.com
RESEND_FROM_NAME=CafeKiosk
# Optional address for replies from invited employees:

# Password recovery uses the same Resend configuration above.
# Secure reset links are one-time and expire after this many minutes.
PASSWORD_RESET_EXPIRES_MINUTES=30


# ============================================================
# SECURITY
# ============================================================
# REQUIRED on Railway for persistent secure login sessions.
# Generate a long random value (at least 32 characters). Example PowerShell:
#   [Convert]::ToHexString((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# Optional comma-separated cross-origin allowlist.
# Leave blank when the frontend is served by the same CafeKiosk domain.
CORS_ALLOWED_ORIGINS=

# Keep hard-coded demo accounts disabled in production.
ALLOW_FALLBACK_DEMO_ACCOUNTS=false

# System Administrator / IT Monitor (required in production)
SYSTEM_ADMIN_USER=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_DISPLAY_NAME=CafeKiosk IT Monitor

# Brute-force protection. Defaults shown below.
LOGIN_WARNING_THRESHOLD=3
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
SYSTEM_ADMIN_WARNING_THRESHOLD=3
SYSTEM_ADMIN_MAX_FAILED_ATTEMPTS=5
SYSTEM_ADMIN_LOCK_MINUTES=15
